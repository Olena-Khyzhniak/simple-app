{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "MovieCast": {
            "type": "object",
            "properties": {
                "movieId": { "type": "number" },
                "actorName": { "type": "string" },
                "roleName": { "type": "string" },
                "roleDescription": { "type": "string" }
            },
            "required": ["movieId", "actorName", "roleName", "roleDescription"],
            "additionalProperties": false
        }
    }
}
